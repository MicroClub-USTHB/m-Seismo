{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://m-seismo.example/schemas/report.schema.json",
  "title": "m-Seismo Web SDK report payload",
  "description": "ASSUMED contract for the report JSON body POSTed by the m-Seismo Web SDK. This file is the single source of truth: the mock receiver validates against it and the unit contract test asserts every produced report validates against it. It has NOT been verified against the real Go backend. Unknown extra fields are tolerated (additionalProperties: true) but should be logged by the receiver.",
  "type": "object",
  "required": [
    "schemaVersion",
    "sdkVersion",
    "reportId",
    "type",
    "trigger",
    "description",
    "error",
    "context",
    "breadcrumbs",
    "networkFailures",
    "screenshot"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "description": "Contract version. 2 since Phase 7 (type/trigger/nullable description/fingerprint).",
      "type": "integer",
      "const": 2
    },
    "sdkVersion": { "type": "string" },
    "reportId": {
      "description": "Client-generated id, stable across retries of the same form session.",
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "manual",
        "manual_with_error",
        "automatic_error",
        "captured_exception",
        "captured_message"
      ]
    },
    "trigger": {
      "type": "string",
      "enum": ["form", "automatic", "api"]
    },
    "description": {
      "description": "Required non-empty for manual/manual_with_error; null for automatic/captured reports.",
      "type": ["string", "null"]
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["type", "message"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "stack": { "type": "string", "maxLength": 8000 },
            "handled": { "type": "boolean" },
            "timestamp": { "type": "string" },
            "source": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "filename": { "type": "string" },
                "line": { "type": "integer" },
                "column": { "type": "integer" }
              }
            },
            "flags": {
              "type": "array",
              "items": { "type": "string" },
              "maxItems": 32
            },
            "context": { "type": "object" },
            "fingerprint": {
              "description": "Stable identity of this error class. Lowercase hex (non-cryptographic).",
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            "occurrences": {
              "description": "Times this fingerprint occurred since the last report sent for it.",
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "required": ["timestamp", "application"],
      "additionalProperties": true,
      "properties": {
        "url": { "type": "string" },
        "timestamp": { "type": "string" },
        "browser": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        },
        "platform": { "type": "string" },
        "viewport": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": true,
          "properties": {
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          }
        },
        "application": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "version": { "type": "string" },
            "environment": { "type": "string" }
          }
        }
      }
    },
    "breadcrumbs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["timestamp", "category", "message"],
        "additionalProperties": true,
        "properties": {
          "timestamp": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "error",
              "unhandledrejection",
              "captured",
              "navigation",
              "interaction",
              "sdk"
            ]
          },
          "message": { "type": "string" },
          "level": { "type": "string", "enum": ["error", "info"] },
          "data": { "type": "object" }
        }
      }
    },
    "networkFailures": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["timestamp", "method", "url", "durationMs", "category"],
        "additionalProperties": true,
        "properties": {
          "timestamp": { "type": "string" },
          "method": { "type": "string" },
          "url": { "type": "string", "maxLength": 1024 },
          "status": { "type": "integer" },
          "durationMs": { "type": "number", "minimum": 0 },
          "category": {
            "type": "string",
            "enum": [
              "http_error",
              "network_error",
              "aborted",
              "other_error",
              "opaque_response"
            ]
          }
        }
      }
    },
    "screenshot": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["name", "mimeType", "sizeBytes", "dataBase64"],
          "additionalProperties": true,
          "properties": {
            "name": { "type": "string" },
            "mimeType": {
              "type": "string",
              "enum": ["image/png", "image/jpeg", "image/webp"]
            },
            "sizeBytes": { "type": "integer", "minimum": 0 },
            "dataBase64": { "type": "string" }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "enum": ["manual", "manual_with_error"] } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "description": { "type": "string", "minLength": 1 }
        }
      },
      "else": {
        "properties": {
          "description": { "type": ["string", "null"] }
        }
      }
    }
  ]
}
