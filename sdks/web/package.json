{
  "name": "@m-seismo/web",
  "version": "0.0.0",
  "description": "m-Seismo Web SDK: bug-reporting form and automatic diagnostics.",
  "private": true,
  "type": "module",
  "main": "./dist/m-seismo-web.js",
  "module": "./dist/m-seismo-web.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/m-seismo-web.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "predev": "node test-app/scripts/build-minified.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lab": "node test-app/scripts/build-minified.mjs && vite",
    "lab:minify": "node test-app/scripts/build-minified.mjs",
    "test:lab": "playwright test tests/e2e/lab.spec.ts",
    "lab:matrix": "node test-app/scripts/lab-matrix.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  }
}
