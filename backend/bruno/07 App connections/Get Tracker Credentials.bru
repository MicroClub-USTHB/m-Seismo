meta {
  name: Get Tracker Credentials
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/apps/{{appId}}/providers/gitlab/credentials
  body: none
  auth: inherit
}

docs {
  200 `{"tracker": "gitlab", "configured": true, "client_id": "..."}` —
  the client secret is never returned. `configured` is `false` and
  `client_id` absent before the app has registered one.
}
