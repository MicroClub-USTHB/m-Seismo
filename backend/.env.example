# Copy to .env and adjust. Used by dbmate (DATABASE_URL) and the app (SEISMO_* via viper).

DATABASE_URL=postgres://seismo:seismo@localhost:5432/seismo?sslmode=disable

SEISMO_SERVER_PORT=8080
SEISMO_SERVER_HOST=0.0.0.0
SEISMO_ENV=development
SEISMO_LOG_LEVEL=info

SEISMO_DATABASE_URL=postgres://seismo:seismo@localhost:5432/seismo?sslmode=disable
SEISMO_DATABASE_MAX_CONNS=10

SEISMO_REDIS_URL=redis://localhost:6379/0

SEISMO_NATS_URL=nats://localhost:4222
