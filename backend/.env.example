# Copy to .env and adjust. Used by dbmate (DATABASE_URL) and the app (SEISMO_* via viper).

DATABASE_URL=postgres://seismo:seismo@localhost:5432/seismo?sslmode=disable

SEISMO_SERVER_PORT=8080
SEISMO_SERVER_HOST=0.0.0.0
SEISMO_ENV=development
SEISMO_LOG_LEVEL=info

SEISMO_DATABASE_URL=postgres://seismo:seismo@localhost:5432/seismo?sslmode=disable
SEISMO_DATABASE_MAX_CONNS=10

SEISMO_REDIS_URL=redis://localhost:6379/0

SEISMO_NATS_URL=nats://localhost:4222

SEISMO_SERVER_PUBLIC_URL=http://localhost:8080
SEISMO_SERVER_FRONTEND_URL=http://localhost:3000

# Required outside development. Use a long random string.
SEISMO_AUTH_JWT_SECRET=
SEISMO_AUTH_JWT_TTL=24h

# Seeds one owner at startup (skipped when either is empty), so there is a
# default account to log into the dashboard with. Not a separate role: the
# seeded owner is a regular owner, and never has its password reset by a
# later restart once it exists.
SEISMO_SUPERADMIN_EMAIL=
SEISMO_SUPERADMIN_PASSWORD=
SEISMO_SUPERADMIN_NAME=Super Admin

# GitHub App (see backend/README.md for setup)
SEISMO_GITHUB_APP_ID=
SEISMO_GITHUB_APP_SLUG=
SEISMO_GITHUB_CLIENT_ID=
SEISMO_GITHUB_CLIENT_SECRET=
# Either the PEM contents or a path to the .pem file
SEISMO_GITHUB_PRIVATE_KEY=
SEISMO_GITHUB_PRIVATE_KEY_PATH=
SEISMO_GITHUB_API_URL=https://api.github.com/
SEISMO_GITHUB_WEB_URL=https://github.com/
# Secret of the App's webhook (issues closed or reopened on GitHub)
SEISMO_GITHUB_WEBHOOK_SECRET=

# GitHub rate-limit handling: spacing between write requests per
# installation, and the longest a call waits out a rate limit.
SEISMO_GITHUB_MIN_WRITE_INTERVAL=1s
SEISMO_GITHUB_MAX_RATE_LIMIT_WAIT=30s

# m-Seismo's own limits
SEISMO_LIMITS_TEST_ISSUES_PER_MINUTE=10

# GitLab and Bitbucket instances (deployment-wide). Each app registers its
# own OAuth application through PUT /apps/{appID}/providers/{tracker}/credentials.
# The redirect URLs default to SEISMO_SERVER_PUBLIC_URL + /api/v1/providers/{tracker}/callback.
SEISMO_GITLAB_WEB_URL=https://gitlab.com/
SEISMO_GITLAB_API_URL=https://gitlab.com/api/v4/
SEISMO_GITLAB_REDIRECT_URL=
SEISMO_GITLAB_MAX_RATE_LIMIT_WAIT=30s
SEISMO_BITBUCKET_WEB_URL=https://bitbucket.org/
SEISMO_BITBUCKET_API_URL=https://api.bitbucket.org/2.0/
SEISMO_BITBUCKET_REDIRECT_URL=
SEISMO_BITBUCKET_MAX_RATE_LIMIT_WAIT=30s

# Encrypts GitLab/Bitbucket OAuth tokens, each app's own OAuth application
# secret and Crashlytics refresh tokens (generate: openssl rand -base64 32).
# Required outside development; empty in development = a fixed development key.
SEISMO_SECRETS_ENCRYPTION_KEY=

# Rate limits on reports sent by the SDKs (see spec/ingestion.md).
SEISMO_INGEST_APP_PER_MINUTE=600
SEISMO_INGEST_APP_BURST=600
SEISMO_INGEST_INSTALLATION_PER_MINUTE=10
SEISMO_INGEST_INSTALLATION_BURST=5

# Crash reporter linked to reports: none | crashlytics. See docs/crashlytics.md.
# Crashlytics refresh tokens are encrypted with SEISMO_SECRETS_ENCRYPTION_KEY.
SEISMO_CRASH_SOURCE=none
SEISMO_CRASH_WINDOW=2m
# OAuth client of this m-Seismo deployment (one per deployment, not per project).
SEISMO_CRASH_CRASHLYTICS_CLIENT_ID=
SEISMO_CRASH_CRASHLYTICS_CLIENT_SECRET=
# Defaults to SEISMO_SERVER_PUBLIC_URL + /api/v1/oauth/crashlytics/callback
SEISMO_CRASH_CRASHLYTICS_REDIRECT_URL=
SEISMO_CRASH_CRASHLYTICS_QUOTA_PROJECT=

# Encrypt per-app crash-provider tokens (generate: openssl rand -base64 32).
# Keep this key stable across restarts; leave empty to disable Sentry setup.
SEISMO_CRASH_PROVIDERS_ENCRYPTION_KEY=
# Space-separated decryption-only keys retained temporarily during encryption-key rotation.
SEISMO_CRASH_PROVIDERS_PREVIOUS_ENCRYPTION_KEYS=
# Space-separated HTTPS origins, including an explicitly allowed self-hosted Sentry if needed.
SEISMO_CRASH_PROVIDERS_SENTRY_ORIGINS=https://sentry.io https://us.sentry.io https://de.sentry.io

# Report-to-issue worker
SEISMO_WORKER_ENABLED=true
SEISMO_WORKER_CONCURRENCY=4
SEISMO_WORKER_MAX_ATTEMPTS=10

# Days a report is kept unless its app sets its own retention
SEISMO_RETENTION_DEFAULT_DAYS=90
# How long a private attachment link stays valid
SEISMO_ATTACHMENTS_LINK_TTL=168h

# Log coordinator (see docs/coordinator.md). Outside development it needs a
# TLS certificate and key, or SEISMO_COORDINATOR_PLAINTEXT=true when TLS ends
# in front of the backend.
SEISMO_COORDINATOR_ENABLED=false
SEISMO_COORDINATOR_ADDR=:9443
SEISMO_COORDINATOR_TLS_CERT_FILE=
SEISMO_COORDINATOR_TLS_KEY_FILE=
SEISMO_COORDINATOR_PLAINTEXT=false
SEISMO_COORDINATOR_WINDOW=2m
SEISMO_COORDINATOR_TIMEOUT=8s
SEISMO_COORDINATOR_MAX_BYTES=262144
SEISMO_COORDINATOR_MAX_LINES_PER_WORKLOAD=200
