# Copy to .env and adjust. Used by dbmate (DATABASE_URL) and the app (SEISMO_* via viper).

DATABASE_URL=postgres://seismo:seismo@localhost:5432/seismo?sslmode=disable

SEISMO_SERVER_PORT=8080
SEISMO_SERVER_HOST=0.0.0.0
SEISMO_ENV=development
SEISMO_LOG_LEVEL=info

SEISMO_DATABASE_URL=postgres://seismo:seismo@localhost:5432/seismo?sslmode=disable
SEISMO_DATABASE_MAX_CONNS=10

SEISMO_REDIS_URL=redis://localhost:6379/0

SEISMO_NATS_URL=nats://localhost:4222

SEISMO_SERVER_PUBLIC_URL=http://localhost:8080
SEISMO_SERVER_FRONTEND_URL=http://localhost:3000

# Required outside development. Use a long random string.
SEISMO_AUTH_JWT_SECRET=
SEISMO_AUTH_JWT_TTL=24h

# GitHub App (see backend/README.md for setup)
SEISMO_GITHUB_APP_ID=
SEISMO_GITHUB_APP_SLUG=
SEISMO_GITHUB_CLIENT_ID=
SEISMO_GITHUB_CLIENT_SECRET=
# Either the PEM contents or a path to the .pem file
SEISMO_GITHUB_PRIVATE_KEY=
SEISMO_GITHUB_PRIVATE_KEY_PATH=

# GitHub rate-limit handling: spacing between write requests per
# installation, and the longest a call waits out a rate limit.
SEISMO_GITHUB_MIN_WRITE_INTERVAL=1s
SEISMO_GITHUB_MAX_RATE_LIMIT_WAIT=30s

# m-Seismo's own limits
SEISMO_LIMITS_TEST_ISSUES_PER_MINUTE=10

# Rate limits on reports sent by the SDKs (see spec/ingestion.md).
SEISMO_INGEST_APP_PER_MINUTE=600
SEISMO_INGEST_APP_BURST=600
SEISMO_INGEST_INSTALLATION_PER_MINUTE=10
SEISMO_INGEST_INSTALLATION_BURST=5

# Encrypts secrets stored in the database. Generate with: openssl rand -base64 32
SEISMO_SECURITY_SECRET_KEY=

# Crash reporter linked to reports: none | crashlytics. See docs/crashlytics.md.
SEISMO_CRASH_SOURCE=none
SEISMO_CRASH_WINDOW=2m
# OAuth client of this m-Seismo deployment (one per deployment, not per project).
SEISMO_CRASH_CRASHLYTICS_CLIENT_ID=
SEISMO_CRASH_CRASHLYTICS_CLIENT_SECRET=
# Defaults to SEISMO_SERVER_PUBLIC_URL + /api/v1/oauth/crashlytics/callback
SEISMO_CRASH_CRASHLYTICS_REDIRECT_URL=
SEISMO_CRASH_CRASHLYTICS_QUOTA_PROJECT=
