# Copy to .env and adjust. Matches deploy/compose.yaml.
DATABASE_URL=postgres://mseismo:mseismo@localhost:5433/mseismo?sslmode=disable
# At least 32 characters. Every /v1 request needs "Authorization: Bearer <token>".
ADMIN_API_TOKEN=change-me-to-a-long-random-string-0123456789
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
MIGRATE_ON_START=true
