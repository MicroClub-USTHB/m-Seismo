# Copy to deploy/.env to override the dev stack's defaults. docker compose
# reads it automatically when run with -f deploy/compose.dev.yml.

# Host ports
# BACKEND_PORT=8080
# POSTGRES_PORT=5432
# FAKEGITHUB_PORT=9090
# FAKEGITLAB_PORT=9091
# FAKEBITBUCKET_PORT=9092

# SEISMO_SERVER_FRONTEND_URL=http://localhost:3000
# SEISMO_AUTH_JWT_SECRET=
# SEISMO_AUTH_JWT_TTL=24h

# GitHub rate-limit handling and m-Seismo's own limits
# SEISMO_GITHUB_MIN_WRITE_INTERVAL=1s
# SEISMO_GITHUB_MAX_RATE_LIMIT_WAIT=30s
# SEISMO_LIMITS_TEST_ISSUES_PER_MINUTE=10

# --- Real GitHub App (leave all commented to use the fake GitHub) ---------
# SEISMO_GITHUB_APP_ID=123456
# SEISMO_GITHUB_APP_SLUG=m-seismo
# SEISMO_GITHUB_CLIENT_ID=Iv1.xxxxxxxx
# SEISMO_GITHUB_CLIENT_SECRET=xxxxxxxx
# PEM on one line with literal \n; takes precedence over the fake's key file
# SEISMO_GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
# SEISMO_GITHUB_API_URL=https://api.github.com/
# SEISMO_GITHUB_WEB_URL=https://github.com/

# --- Token encryption (GitLab and Bitbucket OAuth tokens) -------------------
# 32 random bytes, base64: openssl rand -base64 32
# Empty in the dev stack = a fixed development key. Required elsewhere.
# SEISMO_SECRETS_ENCRYPTION_KEY=

# --- Real GitLab application (leave commented to use the fake GitLab) ----
# Redirect URI to register: http://localhost:8080/api/v1/providers/gitlab/callback
# Scope: api
# SEISMO_GITLAB_CLIENT_ID=
# SEISMO_GITLAB_CLIENT_SECRET=
# SEISMO_GITLAB_WEB_URL=https://gitlab.com/
# SEISMO_GITLAB_API_URL=https://gitlab.com/api/v4/

# --- Real Bitbucket OAuth consumer (leave commented to use the fake) ------
# Callback URL: http://localhost:8080/api/v1/providers/bitbucket/callback
# Permissions: Account Read, Repositories Read, Issues Write
# SEISMO_BITBUCKET_CLIENT_ID=
# SEISMO_BITBUCKET_CLIENT_SECRET=
# SEISMO_BITBUCKET_WEB_URL=https://bitbucket.org/
# SEISMO_BITBUCKET_API_URL=https://api.bitbucket.org/2.0/
