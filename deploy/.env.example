# Copy to deploy/.env to override the stack's defaults. docker compose
# reads it automatically when run with -f deploy/compose.dev.yml. An unset
# or empty SEISMO_* value means the backend's own default; every setting is
# described in backend/.env.example.

# Host ports
# BACKEND_PORT=8080
# COORDINATOR_PORT=9443
# POSTGRES_PORT=5432

# --- Server (compose.server.yml) --------------------------------------------
# Required by compose.server.yml, which refuses to start without them.
# POSTGRES_PASSWORD only applies when the database volume is created.
# POSTGRES_PASSWORD=          # openssl rand -hex 24
# SEISMO_AUTH_JWT_SECRET=     # openssl rand -base64 48
# SEISMO_SECRETS_ENCRYPTION_KEY=   # openssl rand -base64 32
# SEISMO_SERVER_PUBLIC_URL=https://seismo.example.org
# SEISMO_LOG_LEVEL=info

# --- Server and auth --------------------------------------------------------
# SEISMO_SERVER_FRONTEND_URL=http://localhost:3000
# SEISMO_AUTH_JWT_TTL=24h
# SEISMO_DATABASE_MAX_CONNS=10

# Seeds one owner at startup (skipped when either is empty); see
# backend/.env.example.
# SEISMO_SUPERADMIN_EMAIL=
# SEISMO_SUPERADMIN_PASSWORD=
# SEISMO_SUPERADMIN_NAME=Super Admin

# GitHub rate-limit handling and m-Seismo's own limits
# SEISMO_GITHUB_MIN_WRITE_INTERVAL=1s
# SEISMO_GITHUB_MAX_RATE_LIMIT_WAIT=30s
# SEISMO_LIMITS_TEST_ISSUES_PER_MINUTE=10

# Rate limits on reports sent by the SDKs
# SEISMO_INGEST_APP_PER_MINUTE=600
# SEISMO_INGEST_APP_BURST=600
# SEISMO_INGEST_INSTALLATION_PER_MINUTE=10
# SEISMO_INGEST_INSTALLATION_BURST=5

# Report-to-issue worker, retention and attachment links
# SEISMO_WORKER_ENABLED=true
# SEISMO_WORKER_CONCURRENCY=4
# SEISMO_WORKER_MAX_ATTEMPTS=10
# SEISMO_RETENTION_DEFAULT_DAYS=90
# SEISMO_ATTACHMENTS_LINK_TTL=168h

# --- GitHub App -------------------------------------------------------------
# Leave SEISMO_GITHUB_APP_ID empty to run without GitHub.
# SEISMO_GITHUB_APP_ID=123456
# SEISMO_GITHUB_APP_SLUG=m-seismo
# SEISMO_GITHUB_CLIENT_ID=Iv1.xxxxxxxx
# SEISMO_GITHUB_CLIENT_SECRET=xxxxxxxx
# PEM on one line with literal \n (or use SEISMO_GITHUB_PRIVATE_KEY_PATH)
# SEISMO_GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
# SEISMO_GITHUB_API_URL=https://api.github.com/
# SEISMO_GITHUB_WEB_URL=https://github.com/
# Secret of the App's webhook (issues closed or reopened on GitHub)
# SEISMO_GITHUB_WEBHOOK_SECRET=

# --- Token encryption (GitLab/Bitbucket OAuth tokens and each app's own --
# --- OAuth application secret) ----------------------------------------------
# SEISMO_SECRETS_ENCRYPTION_KEY, in the server section above. Empty in the
# dev stack = a fixed development key. Required elsewhere.

# --- GitLab instance (deployment-wide; defaults to gitlab.com) -------------
# Each app registers its own OAuth application's client ID and secret via
# PUT /apps/{appID}/providers/gitlab/credentials, not here. Redirect URI to
# register on that application: http://localhost:8080/api/v1/providers/gitlab/callback
# Scope: api
# SEISMO_GITLAB_WEB_URL=https://gitlab.com/
# SEISMO_GITLAB_API_URL=https://gitlab.com/api/v4/
# SEISMO_GITLAB_REDIRECT_URL=
# SEISMO_GITLAB_MAX_RATE_LIMIT_WAIT=30s

# --- Bitbucket instance (deployment-wide; defaults to bitbucket.org) -------
# Each app registers its own OAuth consumer's key and secret via
# PUT /apps/{appID}/providers/bitbucket/credentials, not here. Callback URL
# to register on that consumer: http://localhost:8080/api/v1/providers/bitbucket/callback
# Permissions: Account Read, Repositories Read, Issues Write
# SEISMO_BITBUCKET_WEB_URL=https://bitbucket.org/
# SEISMO_BITBUCKET_API_URL=https://api.bitbucket.org/2.0/
# SEISMO_BITBUCKET_REDIRECT_URL=
# SEISMO_BITBUCKET_MAX_RATE_LIMIT_WAIT=30s

# --- Crash reporters --------------------------------------------------------
# Crashlytics: none | crashlytics. See backend/docs/crashlytics.md.
# SEISMO_CRASH_SOURCE=none
# SEISMO_CRASH_WINDOW=2m
# SEISMO_CRASH_CRASHLYTICS_CLIENT_ID=
# SEISMO_CRASH_CRASHLYTICS_CLIENT_SECRET=
# SEISMO_CRASH_CRASHLYTICS_REDIRECT_URL=
# SEISMO_CRASH_CRASHLYTICS_QUOTA_PROJECT=

# Encrypt per-app crash-provider tokens (generate: openssl rand -base64 32).
# Keep this key stable across restarts; leave empty to disable Sentry setup.
SEISMO_CRASH_PROVIDERS_ENCRYPTION_KEY=
# Space-separated decryption-only keys retained temporarily during encryption-key rotation.
SEISMO_CRASH_PROVIDERS_PREVIOUS_ENCRYPTION_KEYS=
# Space-separated HTTPS origins, including an explicitly allowed self-hosted Sentry if needed.
SEISMO_CRASH_PROVIDERS_SENTRY_ORIGINS=https://sentry.io https://us.sentry.io https://de.sentry.io

# --- Log coordinator (see backend/docs/coordinator.md) ----------------------
# Plaintext in development. On a server, compose.server.yml binds it to
# 127.0.0.1 in plaintext; set a certificate and key (mounted into the
# container) before exposing it.
# SEISMO_COORDINATOR_TLS_CERT_FILE=
# SEISMO_COORDINATOR_TLS_KEY_FILE=
# SEISMO_COORDINATOR_PLAINTEXT=
# SEISMO_COORDINATOR_WINDOW=2m
# SEISMO_COORDINATOR_TIMEOUT=8s
# SEISMO_COORDINATOR_MAX_BYTES=262144
# SEISMO_COORDINATOR_MAX_LINES_PER_WORKLOAD=200
